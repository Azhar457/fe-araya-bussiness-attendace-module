# Basis URL BE live. FE mengirim cookie sesi (araya_employee) sebagai header
# X-Employee-Id — BE autentikasi per endpoint, bukan token.
NEXT_PUBLIC_API_BASE_URL=https://laboratorium-backend.vercel.app

# Flag legacy: FE tidak lagi punya mode mock (semua route handler mock dihapus).
# Dibiarkan false supaya tidak ada ambiguitas; nilai ini tidak dibaca client.
NEXT_PUBLIC_USE_MOCK=false
