# true  = pakai route handler mock internal (src/app/api/mock/**)
# false = pakai BE asli (isi NEXT_PUBLIC_API_BASE_URL)
NEXT_PUBLIC_USE_MOCK=true

# Basis URL BE. Dipakai hanya ketika NEXT_PUBLIC_USE_MOCK=false.
# Jangan hardcode di kode — seluruh URL request dibangun dari nilai ini.
NEXT_PUBLIC_API_BASE_URL=https://<be>.vercel.app

# Id karyawan & role tidak perlu di env — diambil dari sesi login (cookie EMPLOYEE_COOKIE)
# atau dari input di halaman /masuk, bukan nilai statis.

# Geofence kantor — dipakai ValidasiLokasiKerja (haversine, default radius 50 m).
# Biarkan kosong bila ingin menampilkan status "koordinat kantor belum di-set".
NEXT_PUBLIC_OFFICE_LAT=
NEXT_PUBLIC_OFFICE_LNG=
# Radius geofence (meter), default 50.
NEXT_PUBLIC_OFFICE_RADIUS_M=50
