# Basis URL BE live (M13). FE mengirim Bearer token M12 ke semua endpoint M13.
NEXT_PUBLIC_API_BASE_URL=YOUR_BACKEND_URL

# M12 (Kel. C3) — dipakai server-side oleh proxy /api/m12/karyawan-aktif.
# M12 tidak mengirim header CORS, jadi browser tidak boleh memanggil langsung.
M12_API_BASE_URL=https://kelompok4-m12-sistem-hr-manajemen-d.vercel.app

# M14 (Kel. C5) — kosongkan sampai endpoint penerima rekap disepakati.
# Selama kosong, POST /api/m14/rekap membalas { sent: false } + payload siap.
M14_RECAP_ENDPOINT=

# Flag legacy: FE tidak lagi punya mode mock (semua route handler mock dihapus).
# Dibiarkan false supaya tidak ada ambiguitas; nilai ini tidak dibaca client.
NEXT_PUBLIC_USE_MOCK=false
